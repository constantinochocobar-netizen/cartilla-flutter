rules_version = '2';

// Modo de prueba: cualquiera puede leer y escribir durante 30 días.
// Sirve para aprender; para una app real hay que restringirlo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 5);
    }
  }
}
